Options -Indexes

RewriteEngine On

# Fallback untuk hosting yang belum dapat mengarahkan document root ke public/.
# Produksi tetap disarankan memakai public/ sebagai satu-satunya document root.
RewriteRule ^(?:app|storage|docs|handoffs|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env(?:\.|$)|AGENTS\.md$|README\.md$|CATATAN\.md$|LAPORAN\.md$|CHANGELOG_FIXES\.md$) - [F,L,NC]

RewriteRule ^public(?:/|$) - [L,NC]
RewriteRule ^(?:index\.php)?$ public/index.php [L]
RewriteRule ^(.+)$ public/$1 [L]
