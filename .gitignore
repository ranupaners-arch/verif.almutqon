/storage/logs/*
!/storage/logs/.gitkeep

# Generated uploads / avatars
/public/assets/avatars/*
!/public/assets/avatars/.gitkeep
!/public/assets/avatars/.htaccess

# Logs / cache / temp / backups
*.log
*.cache
*.tmp
*.temp
*.bak
*~
