; Salin ke .env atau pasang sebagai environment server. Jangan commit nilai produksi.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_SECRET_KEY=replace-with-at-least-32-random-characters

DB_HOST=db.example.internal
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_user
DB_PASSWORD=replace-with-a-strong-database-password

; API internal v1 untuk integrasi ALMUTQON.
VERIF_API_TOKEN=replace-with-a-long-random-hex-token
VERIF_API_SYSTEM_ACTOR_KEY=almutqon_bridge

; Reset password memakai mail bawaan PHP. Aktifkan hanya jika mail server siap.
MAIL_ENABLED=false
MAIL_FROM=no-reply@your-domain.example
MAIL_FROM_NAME="AL MUTQON Verification"

; --- Wajib diisi di production -------------------------------------------
; Token untuk membuka /diagnosa.php. Kosongkan untuk menonaktifkan halaman.
APP_SETUP_TOKEN=replace-with-at-least-32-random-characters

; --- Opsional, ada nilai default ----------------------------------------
; Zona waktu tampilan & cap waktu log. Default Asia/Jakarta.
APP_TIMEZONE=Asia/Jakarta

; Set true HANYA bila aplikasi berada di belakang reverse proxy tepercaya
; (Cloudflare, load balancer) yang meneruskan X-Forwarded-Proto.
APP_TRUST_PROXY=false

; Batas ukuran & rate limit (detik/jumlah). Numeric.
MAX_UPLOAD_BYTES=10485760
UPLOAD_RATE_WINDOW_SECONDS=600
MAX_UPLOAD_ATTEMPTS=15
API_RATE_WINDOW_SECONDS=60
MAX_API_ATTEMPTS=60
VERIFY_RATE_WINDOW_SECONDS=60
MAX_VERIFY_ATTEMPTS=30
LOGIN_RATE_WINDOW_SECONDS=900
MAX_LOGIN_ATTEMPTS=5
RESET_RATE_WINDOW_SECONDS=900
MAX_RESET_ATTEMPTS=5

; Cache-buster asset. Naikkan satu kali setiap kali app.css/portal.css/nav.js berubah.
ASSET_VERSION=20260930a

; Lokasi direktori. Kosongkan bila struktur standard (paling aman di shared hosting).
; APP_STORAGE_PATH=/home/akun/verif/storage
; APP_PUBLIC_PATH=/home/akun/verif/public
; APP_UPLOAD_DIR=/home/akun/verif/storage/uploads
; APP_AVATAR_DIR=/home/akun/verif/storage/uploads/avatars
; APP_LOG_DIR=/home/akun/verif/storage/logs
