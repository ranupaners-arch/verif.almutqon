# Supply these values through your server environment; do not commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_user
DB_PASSWORD=
APP_URL=https://your-domain.example
APP_SECRET_KEY=replace-with-a-long-random-secret
# Token Bearer untuk API internal v1 (integrasi ALMUTQON). Isi 64-char hex acak.
VERIF_API_TOKEN=replace-with-a-long-random-hex-token
# Technical key system actor pembuat dokumen via API (bukan akun staff/login).
VERIF_API_SYSTEM_ACTOR_KEY=almutqon_bridge
